# Chatter Remote gateway: plain-HTTP front for an OpenAI-compatible model server that
# is only reachable from inside the server (for example a Kubernetes ClusterIP service
# with a private-CA TLS certificate).
#
# ${UPSTREAM} is filled in from the environment when the container starts.
# Only /v1/ is forwarded, so nothing else on the upstream is exposed.

server {
    listen ${LISTEN_PORT};
    server_name _;

    # Browsers may send a CORS preflight; the extension has host access, other clients may not.
    location /v1/ {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin  "*" always;
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
            add_header Access-Control-Allow-Headers "*" always;
            add_header Access-Control-Max-Age       "86400" always;
            return 204;
        }

        proxy_pass ${UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        # The upstream certificate comes from a private CA, so it cannot be verified here.
        # This hop stays on the server itself (loopback / cluster network).
        proxy_ssl_server_name on;
        proxy_ssl_verify off;

        # Streaming answers (SSE) must not be buffered
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
        client_max_body_size 64m;

        add_header Access-Control-Allow-Origin "*" always;
    }

    location = /healthz {
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 404;
    }
}
